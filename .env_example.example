# ============================================
# CONFIGURACIÓN DEL SISTEMA DE AGENTES
# ============================================
# Copia este archivo a .env y configura tus valores

# ============================================
# RAG REMOTO (API Backend)
# ============================================
# URL de tu servidor RAG (puede ser local o remoto con Cloudflare Tunnel)
# Ejemplo local: http://localhost:8000
# Ejemplo remoto: https://tu-dominio.com
RAG_BASE_URL=https://swagger-rag.loquinto.com

# API Key para autenticación con el servidor RAG
# Genera una con: uv run python scripts/generar_clave.py
RAG_API_KEY=tu_clave_secreta_aqui

# ============================================
# OLLAMA (Modelos Locales)
# ============================================
# URL base de Ollama (normalmente localhost)
OLLAMA_BASE_URL=http://localhost:11434
